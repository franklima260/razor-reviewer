#!/bin/sh
# install-checks [repo-path]
#
# Puts the ledger/handoff check into a project, for every agent at once:
#   <repo>/.githooks/pre-commit   - runs on each commit
#   <repo>/.githooks/check-docs   - the checks themselves
#   git config core.hooksPath .githooks
#
# core.hooksPath keeps the hook in version control, so a new clone, a new
# machine or a new agent is covered with no further setup.

src=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo=${1:-.}

cd "$repo" || exit 1
git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repository: $repo" >&2; exit 1; }
top=$(git rev-parse --show-toplevel) && cd "$top" || exit 1

mkdir -p .githooks || exit 1
cp "$src/check-docs"          .githooks/check-docs || exit 1
cp "$src/githooks/pre-commit" .githooks/pre-commit || exit 1
chmod +x .githooks/check-docs .githooks/pre-commit 2>/dev/null
git config core.hooksPath .githooks || exit 1

# A hook with CRLF endings will not run. Pin the hooks to LF.
if ! grep -q '^\.githooks/' .gitattributes 2>/dev/null; then
  printf '.githooks/** text eol=lf
' >> .gitattributes
  echo "  .gitattributes: pinned .githooks/** to LF"
fi

echo "installed in $top"
echo "  .githooks/pre-commit  .githooks/check-docs  (core.hooksPath=.githooks)"
echo "Commit both files, so every agent and every clone gets the same check."
